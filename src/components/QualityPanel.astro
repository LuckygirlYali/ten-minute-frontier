---
import type { DailyDigest } from "../lib/types";

interface Props {
  digest: DailyDigest;
}

const { digest } = Astro.props;
const health = Math.round((digest.quality.sourcesHealthy / digest.quality.sourcesChecked) * 100);
---

<details class="quality-note" id="quality">
  <summary>编选说明</summary>
  <div class="quality-note-body">
    <p>RSS 与网页搜索共同发现候选；官方源优先，重大信息尽量交叉核验。无法确认原始链接的条目不会发布。</p>
    <p class="quality-note-stats">
      信源健康 {health}% · 原始信号 {digest.quality.rawSignals} · 去重后 {digest.quality.afterDeduplication} · 链接核验 {digest.quality.linksVerified}
    </p>
    <ul>{digest.quality.notes.map((note) => <li>{note}</li>)}</ul>
  </div>
</details>
