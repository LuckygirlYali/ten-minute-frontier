---
import "../styles/global.css";
import { site, withBase } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = site.name, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(withBase("/social-card.png"), Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2f0e9" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title === site.name ? title : `${title}｜${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={withBase("/favicon.png")} />
    <title>{title === site.name ? title : `${title}｜${site.name}`}</title>
    <script is:inline>
      document.documentElement.dataset.js = "true";
    </script>
  </head>
  <body>
    <slot />
    <script>
      import "../scripts/client";
    </script>
  </body>
</html>
