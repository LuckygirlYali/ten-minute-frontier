---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { detailPath, getDetail } from "../../lib/details";
import { digestPath, digests, formatChineseDate, formatTime } from "../../lib/digests";
import { withBase } from "../../lib/site";

export const getStaticPaths = (() =>
  digests.flatMap((digest) =>
    digest.items.map((item) => ({
      params: { id: item.id },
      props: { item, digest },
    })),
  )) satisfies GetStaticPaths;

const { item, digest } = Astro.props;
const detail = getDetail(item);
const sections = [
  ["完整事实", detail.facts, "fact"],
  ["必要背景", detail.background, "fact"],
  ["为什么重要", detail.significance, "meaning"],
  ["各方反应", detail.reactions, "fact"],
  ["信息边界与不确定性", detail.uncertainties, "uncertainty"],
  ["接下来具体看什么", detail.watch, "watch"],
] as const;
---

<BaseLayout title={item.title} description={detail.introduction ?? item.summary}>
  <div id="top"></div>
  <SiteHeader />
  <main class="shell briefing-page">
    <nav class="briefing-back" aria-label="返回日报">
      <a href={withBase(digestPath(digest.date))}>← 返回 {formatChineseDate(digest.date)}日报</a>
    </nav>

    <article class="briefing-article">
      <header class="briefing-hero">
        <div class="story-kicker">
          <span class:list={["signal", `signal--${item.importance}`]}>{item.importance}</span>
          <span>{item.category}</span>
          <span>{item.kind}</span>
          <span>{formatTime(item.publishedAt)} 发布</span>
        </div>
        <h1>{item.title}</h1>
        {detail.introduction && <p class="briefing-conclusion">{detail.introduction}</p>}
      </header>

      <div class="briefing-copy">
        {sections.map(([heading, paragraphs, kind]) => paragraphs?.length && (
          <section class:list={["briefing-section", `briefing-section--${kind}`]}>
            <h2>{heading}</h2>
            {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </section>
        ))}

        {detail.analysis?.length && (
          <section class="briefing-section briefing-section--analysis">
            <h2>更深层分析 <small>以下为 AI 生成的编辑判断</small></h2>
            {detail.analysis.map((paragraph) => <p>{paragraph}</p>)}
          </section>
        )}

        {!item.detail && (
          <aside class="briefing-boundary">
            这是一篇旧版归档，详情材料尚未与首页摘要分离；本页不补写来源没有确认的内容。
          </aside>
        )}

        {item.correction && (
          <aside class="correction"><strong>更正</strong> {item.correction.note}</aside>
        )}

        <section class="briefing-sources" aria-labelledby="briefing-sources-title">
          <h2 id="briefing-sources-title">原始来源</h2>
          <ul>
            {item.sources.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noreferrer">
                  {source.name}<span>↗</span>
                </a>
                <small>{source.kind}{source.paywalled ? " · 付费" : ""}</small>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </article>

    <nav class="briefing-end" aria-label="详情页尾部导航">
      <a href={withBase(digestPath(digest.date))}>返回当日日报</a>
      <a href={withBase(detailPath(item.id)) + "#top"}>回到顶部 ↑</a>
    </nav>
  </main>
</BaseLayout>
